# --- API server (apps/api) ---
PORT=8787
ANTHROPIC_API_KEY=            # chat assistant
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Grocers (each adapter is disabled until its keys are set) ---
INSTACART_API_KEY=            # Instacart Developer Platform (covers Costco, Safeway, Publix, Aldi, Sprouts, ...)
INSTACART_ENV=development     # development | production
KROGER_CLIENT_ID=             # Kroger Public API (Kroger, Ralphs, Fred Meyer, King Soopers, ...)
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=http://localhost:8787/grocers/kroger/callback
WALMART_AFFILIATE_ID=         # Walmart add-to-cart deep links

# --- App (apps/app, Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:8787
