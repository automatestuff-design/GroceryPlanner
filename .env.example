# API server, ingest CLI and tests. Copy to `.env` at the repo root.
# The app's settings live separately in apps/app/.env.example (Expo only reads .env from its own folder).
# Server-only secrets here: never copy them into apps/app/.env.

# ===== API server (apps/api) =====
PORT=8787
APP_URL=http://localhost:8081          # where the app runs; used after grocer account linking
CORS_ORIGINS=                          # comma-separated app origins in production (blank = any)
ANTHROPIC_API_KEY=                     # chat assistant

# --- Supabase (leave SUPABASE_URL/DATABASE_URL blank for the in-memory dev backend) ---
SUPABASE_URL=                          # https://<project-ref>.supabase.co
DATABASE_URL=                          # Project Settings → Database → connection string (server only, never in the app)
SUPABASE_JWT_SECRET=                   # only for projects still on the legacy shared JWT secret; leave blank to use signing keys (JWKS)
APP_SECRET_KEY=                        # 32 random bytes, base64: `openssl rand -base64 32`. Encrypts grocer tokens, signs OAuth state.

# --- Live recipe sources (optional; each is used only when its keys are set) ---
SPOONACULAR_API_KEY=                   # https://spoonacular.com/food-api
EDAMAM_APP_ID=                         # https://developer.edamam.com (Recipe Search API)
EDAMAM_APP_KEY=

# --- Grocers (each adapter is disabled until its keys are set) ---
INSTACART_API_KEY=                     # Instacart Developer Platform
INSTACART_ENV=development              # development | production
KROGER_CLIENT_ID=                      # Kroger Public API
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=http://localhost:8787/grocers/kroger/callback
WALMART_AFFILIATE_ID=
